# DB
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/mneme

# Redis
REDIS_URL=redis://localhost:6380/0

# Auth (replace in any shared or production environment)
JWT_SECRET=mneme-dev-secret-change-in-prod!

# Learning Event v2 rollout (disable only for an explicit rollback window)
LEARNING_EVENT_V2_DUAL_WRITE_ENABLED=1
LEARNING_EVENT_V2_BACKFILL_ENABLED=0

# LLM
MNEME_LLM=veya
VEYA_BASE_URL=http://localhost:8791/v1
VEYA_API_KEY=
VEYA_MODEL=veya1.2-128K
VEYA_VL_MODEL=veya1.2-vl
ANTHROPIC_API_KEY=your_key_here

# Storage
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mneme
