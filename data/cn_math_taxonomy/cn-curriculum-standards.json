      "page_or_ref": "课标印刷页码 57"
    },
    {
      "id": "cms-2022:4.NA.42",
      "domain": "数与代数",
      "theme": "函数",
      "section": "一次函数",
      "clause": "④",
      "text": "能用一次函数解决简单实际问题。",
      "page_or_ref": "课标印刷页码 57"
    },
