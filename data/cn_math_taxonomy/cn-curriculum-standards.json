      "page_or_ref": "课标印刷页码 56"
    },
    {
      "id": "cms-2022:4.NA.29",
      "domain": "数与代数",
      "theme": "方程与不等式",
      "section": "方程与方程组",
      "clause": "⑦",
      "text": "了解一元二次方程的根与系数的关系（例67）。",
      "page_or_ref": "课标印刷页码 56"
    },
    {
      "id": "cms-2022:4.NA.30",
      "domain": "数与代数",
      "theme": "方程与不等式",
      "section": "方程与方程组",
      "clause": "⑧",
      "text": "能根据具体问题的实际意义，检验方程解的合理性。",
