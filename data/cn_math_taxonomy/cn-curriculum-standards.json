    },
    {
      "id": "cms-2022:4.GG.02",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "点、线、面、角",
      "clause": "②",
      "text": "会比较线段的长短，理解线段的和、差，以及线段中点的意义。",
      "page_or_ref": "课标印刷页码 63"
    },
    {
      "id": "cms-2022:4.GG.03",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "点、线、面、角",
      "clause": "③",
      "text": "掌握基本事实：两点确定一条直线。",
      "page_or_ref": "课标印刷页码 63"
    },
    {
      "id": "cms-2022:4.GG.04",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "点、线、面、角",
      "clause": "④",
      "text": "掌握基本事实：两点之间线段最短。",
      "page_or_ref": "课标印刷页码 63"
    },
    {
      "id": "cms-2022:4.GG.05",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "点、线、面、角",
      "clause": "⑤",
      "text": "理解两点间距离的意义，能度量和表达两点间的距离。",
      "page_or_ref": "课标印刷页码 63"
    },
    {
      "id": "cms-2022:4.GG.06",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "点、线、面、角",
      "clause": "⑥",
      "text": "理解角的概念，能比较角的大小；认识度、分、秒等角的度量单位，能进行简单的单位换算，会计算角的和、差。",
      "page_or_ref": "课标印刷页码 63"
    },
    {
      "id": "cms-2022:4.GG.07",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "点、线、面、角",
      "clause": "⑦",
      "text": "能用尺规作图：作一个角等于已知角；作一个角的平分线。",
      "page_or_ref": "课标印刷页码 64"
    },
    {
      "id": "cms-2022:4.GG.08",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "①",
      "text": "理解对顶角、余角、补角等概念，探索并掌握对顶角相等、同角（或等角）的余角相等、同角（或等角）的补角相等的性质。",
      "page_or_ref": "课标印刷页码 64"
    },
    {
      "id": "cms-2022:4.GG.09",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "②",
      "text": "理解垂线、垂线段等概念，能用三角板或量角器过一点画已知直线的垂线。",
      "page_or_ref": "课标印刷页码 64"
    },
    {
      "id": "cms-2022:4.GG.10",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "③",
      "text": "能用尺规作图：作一条线段的垂直平分线；过一点作已知直线的垂线（例73）。",
      "page_or_ref": "课标印刷页码 64"
    },
    {
      "id": "cms-2022:4.GG.11",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "④",
      "text": "掌握基本事实：同一平面内，过一点有且只有一条直线与已知直线垂直。",
      "page_or_ref": "课标印刷页码 64"
    },
    {
      "id": "cms-2022:4.GG.12",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "⑤",
      "text": "理解点到直线的距离的意义，能度量点到直线的距离。",
      "page_or_ref": "课标印刷页码 64"
    },
    {
      "id": "cms-2022:4.GG.13",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "⑥",
      "text": "识别同位角、内错角、同旁内角。",
      "page_or_ref": "课标印刷页码 64"
    },
    {
      "id": "cms-2022:4.GG.14",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "⑦",
      "text": "理解平行线的概念。",
      "page_or_ref": "课标印刷页码 64"
    },
    {
      "id": "cms-2022:4.GG.15",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "⑧",
      "text": "掌握平行线基本事实Ⅰ：过直线外一点有且只有一条直线与这条直线平行。",
      "page_or_ref": "课标印刷页码 64"
    },
    {
      "id": "cms-2022:4.GG.16",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "⑨",
      "text": "掌握平行线基本事实Ⅱ：两条直线被第三条直线所截，如果同位角相等，那么这两条直线平行。",
      "page_or_ref": "课标印刷页码 64"
    },
    {
      "id": "cms-2022:4.GG.17",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "⑩",
      "text": "探索并证明平行线的判定定理：两条直线被第三条直线所截，如果内错角相等（或同旁内角互补），那么这两条直线平行。",
      "page_or_ref": "课标印刷页码 64"
    },
    {
      "id": "cms-2022:4.GG.18",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "⑪",
      "text": "掌握平行线的性质定理Ⅰ：两条平行直线被第三条直线所截，同位角相等。*了解定理的证明（例74）。",
      "page_or_ref": "课标印刷页码 64"
    },
    {
      "id": "cms-2022:4.GG.19",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "⑫",
      "text": "探索并证明平行线的性质定理Ⅱ：两条平行直线被第三条直线所截，内错角相等（或同旁内角互补）。",
      "page_or_ref": "课标印刷页码 64"
    },
    {
      "id": "cms-2022:4.GG.20",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "⑬",
      "text": "能用三角板和直尺过已知直线外一点画这条直线的平行线。",
      "page_or_ref": "课标印刷页码 64"
    },
    {
      "id": "cms-2022:4.GG.21",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "⑭",
      "text": "能用尺规作图：过直线外一点作这条直线的平行线。",
      "page_or_ref": "课标印刷页码 65"
    },
    {
      "id": "cms-2022:4.GG.22",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "相交线与平行线",
      "clause": "⑮",
      "text": "了解平行于同一条直线的两条直线平行。",
      "page_or_ref": "课标印刷页码 65"
    },
    {
      "id": "cms-2022:4.GG.23",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "①",
      "text": "理解三角形及其内角、外角、中线、高线、角平分线等概念，了解三角形的稳定性。",
      "page_or_ref": "课标印刷页码 65"
    },
    {
      "id": "cms-2022:4.GG.24",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "②",
      "text": "探索并证明三角形的内角和定理。掌握它的推论：三角形的外角等于与它不相邻的两个内角的和。",
      "page_or_ref": "课标印刷页码 65"
    },
    {
      "id": "cms-2022:4.GG.25",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "③",
      "text": "证明三角形的任意两边之和大于第三边。",
      "page_or_ref": "课标印刷页码 65"
    },
    {
      "id": "cms-2022:4.GG.26",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "④",
      "text": "理解全等三角形的概念，能识别全等三角形中的对应边、对应角。",
      "page_or_ref": "课标印刷页码 65"
    },
    {
      "id": "cms-2022:4.GG.27",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "⑤",
      "text": "掌握基本事实：两边及其夹角分别相等的两个三角形全等。",
      "page_or_ref": "课标印刷页码 65"
    },
    {
      "id": "cms-2022:4.GG.28",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "⑥",
      "text": "掌握基本事实：两角及其夹边分别相等的两个三角形全等。",
      "page_or_ref": "课标印刷页码 65"
    },
    {
      "id": "cms-2022:4.GG.29",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "⑦",
      "text": "掌握基本事实：三边分别相等的两个三角形全等。",
      "page_or_ref": "课标印刷页码 65"
    },
    {
      "id": "cms-2022:4.GG.30",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "⑧",
      "text": "证明定理：两角分别相等且其中一组等角的对边相等的两个三角形全等。",
      "page_or_ref": "课标印刷页码 65"
    },
    {
      "id": "cms-2022:4.GG.31",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "⑨",
      "text": "理解角平分线的概念，探索并证明角平分线的性质定理：角平分线上的点到角两边的距离相等；反之，角的内部到角两边距离相等的点在角的平分线上。",
      "page_or_ref": "课标印刷页码 65"
    },
    {
      "id": "cms-2022:4.GG.32",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "⑩",
      "text": "理解线段垂直平分线的概念，探索并证明线段垂直平分线的性质定理：线段垂直平分线上的点到线段两端的距离相等；反之，到线段两端距离相等的点在线段的垂直平分线上。",
      "page_or_ref": "课标印刷页码 65"
    },
    {
      "id": "cms-2022:4.GG.33",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "⑪",
      "text": "理解等腰三角形的概念，探索并证明等腰三角形的性质定理：等腰三角形的两个底角相等；底边上的高线、中线及顶角平分线重合。探索并掌握等腰三角形的判定定理：有两个角相等的三角形是等腰三角形。探索等边三角形的性质定理：等边三角形的各角都等于60°。探索等边三角形的判定定理：三个角都相等的三角形（或有一个角是60°的等腰三角形）是等边三角形。",
      "page_or_ref": "课标印刷页码 65"
    },
    {
      "id": "cms-2022:4.GG.34",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "⑫",
      "text": "理解直角三角形的概念，探索并掌握直角三角形的性质定理：直角三角形的两个锐角互余，直角三角形斜边上的中线等于斜边的一半。掌握有两个角互余的三角形是直角三角形。",
      "page_or_ref": "课标印刷页码 65/66"
    },
    {
      "id": "cms-2022:4.GG.35",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "⑬",
      "text": "探索勾股定理及其逆定理，并能运用它们解决一些简单的实际问题。",
      "page_or_ref": "课标印刷页码 66"
    },
    {
      "id": "cms-2022:4.GG.36",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "⑭",
      "text": "探索并掌握判定直角三角形全等的“斜边、直角边”定理。",
      "page_or_ref": "课标印刷页码 66"
    },
    {
      "id": "cms-2022:4.GG.37",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "⑮",
      "text": "了解三角形重心的概念。",
      "page_or_ref": "课标印刷页码 66"
    },
    {
      "id": "cms-2022:4.GG.38",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "三角形",
      "clause": "⑯",
      "text": "能用尺规作图：已知三边、两边及其夹角、两角及其夹边作三角形；已知底边及底边上的高线作等腰三角形；已知一直角边和斜边作直角三角形。",
      "page_or_ref": "课标印刷页码 66"
    },
    {
      "id": "cms-2022:4.GG.39",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "四边形",
      "clause": "①",
      "text": "了解多边形（本标准中多边形指凸多边形）的概念及多边形的顶点、边、内角、外角与对角线；探索并掌握多边形内角和与外角和公式。",
      "page_or_ref": "课标印刷页码 66"
    },
    {
      "id": "cms-2022:4.GG.40",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "四边形",
      "clause": "②",
      "text": "理解平行四边形、矩形、菱形、正方形、梯形的概念，以及它们之间的关系；了解四边形的不稳定性。",
      "page_or_ref": "课标印刷页码 66"
    },
    {
      "id": "cms-2022:4.GG.41",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "四边形",
      "clause": "③",
      "text": "探索并证明平行四边形的性质定理：平行四边形的对边相等、对角相等、对角线互相平分。探索并证明平行四边形的判定定理：一组对边平行且相等的四边形是平行四边形；两组对边分别相等的四边形是平行四边形；对角线互相平分的四边形是平行四边形。",
      "page_or_ref": "课标印刷页码 66"
    },
    {
      "id": "cms-2022:4.GG.42",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "四边形",
      "clause": "④",
      "text": "理解两条平行线之间距离的概念，能度量两条平行线之间的距离。",
      "page_or_ref": "课标印刷页码 66"
    },
    {
      "id": "cms-2022:4.GG.43",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "四边形",
      "clause": "⑤",
      "text": "探索并证明矩形、菱形的性质定理：矩形的四个角都是直角，对角线相等；菱形的四条边相等，对角线互相垂直。探索并证明矩形、菱形的判定定理：三个角是直角的四边形是矩形，对角线相等的平行四边形是矩形；四边相等的四边形是菱形，对角线互相垂直的平行四边形是菱形。正方形既是矩形，又是菱形；理解矩形、菱形、正方形之间的包含关系。",
      "page_or_ref": "课标印刷页码 66"
    },
    {
      "id": "cms-2022:4.GG.44",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "四边形",
      "clause": "⑥",
      "text": "探索并证明三角形的中位线定理。",
      "page_or_ref": "课标印刷页码 67"
    },
    {
      "id": "cms-2022:4.GG.45",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "圆",
      "clause": "①",
      "text": "理解圆、弧、弦、圆心角、圆周角的概念，了解等圆、等弧的概念；探索并掌握点与圆的位置关系。",
      "page_or_ref": "课标印刷页码 67"
    },
    {
      "id": "cms-2022:4.GG.46",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "圆",
      "clause": "②",
      "text": "探索并证明垂径定理：垂直于弦的直径平分弦以及弦所对的两条弧。",
      "page_or_ref": "课标印刷页码 67"
    },
    {
      "id": "cms-2022:4.GG.47",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "圆",
      "clause": "③",
      "text": "探索圆周角与圆心角及其所对弧的关系，知道同弧（或等弧）所对的圆周角相等。了解并证明圆周角定理及其推论：圆周角等于它所对弧上的圆心角的一半；直径所对的圆周角是直角，90°的圆周角所对的弦是直径；圆内接四边形的对角互补。",
      "page_or_ref": "课标印刷页码 67"
    },
    {
      "id": "cms-2022:4.GG.48",
      "domain": "图形与几何",
      "theme": "图形的性质",
      "section": "圆",
      "clause": "④",
      "text": "了解三角形的内心与外心。",
      "page_or_ref": "课标印刷页码 67"
    },
    {
      "id": "cms-2022:4.GG.49",
